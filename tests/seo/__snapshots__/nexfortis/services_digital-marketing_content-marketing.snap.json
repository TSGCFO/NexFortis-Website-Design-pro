    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is content marketing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Content marketing is the practice of earning customers by publishing genuinely useful content — articles, guides, pillar pages — instead of just buying their attention with ads. Done well, it ranks in search, builds trust over time, and increasingly gets cited by AI engines. It's a long-term asset: a good page keeps bringing in readers and leads for years."
          }
        },
        {
          "@type": "Question",
          "name": "Why is content marketing important?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Because rankings need something worth ranking, and buyers research before they buy. Content is what answers their questions, earns their trust, and gives Google and AI engines a reason to point to you instead of a competitor. It also compounds — unlike ads, the work keeps paying off long after it's published."
          }
        },
        {
          "@type": "Question",
          "name": "Does content marketing help my SEO and AI visibility?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Directly. Strong, well-structured content is the raw material SEO ranks and AI engines cite. We build content with both in mind — thorough enough to rank, and structured into clear passages with the right schema so AI tools can lift and quote it. It works hand in hand with our SEO and Generative Engine Optimization services."
          }
        },
        {
          "@type": "Question",
          "name": "Do you write the content yourselves?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We research, draft, edit, and fact-check each piece, with your review before it publishes. We use AI as a tool where it helps, but we don't ship spun, unverified copy — every claim is checked against a real source or cut, because thin AI filler is exactly what Google's helpful-content system penalises."
          }
        },
        {
          "@type": "Question",
          "name": "How long until content marketing works?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Like SEO, it's a compounding play rather than an instant one. Expect early traction on lower-competition topics within a few months and meaningful momentum around the six-month mark, building from there. We report rankings, traffic, and leads per piece so you can see it working along the way."
          }
        }
      ]
    },
