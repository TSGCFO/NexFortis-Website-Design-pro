    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is included in NexFortis's content marketing service?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our content marketing service includes content strategy and planning, SEO blog and article writing, website and landing-page copy, video content, content distribution, and B2B content — all tied to real keyword research and backed by monthly reporting."
          }
        },
        {
          "@type": "Question",
          "name": "How much do content marketing services cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The cost of content marketing varies with what you need — how often you publish, how detailed each piece is, and how competitive your market is — which is why we scope every engagement after a free consultation rather than quoting a one-size-fits-all price."
          }
        },
        {
          "@type": "Question",
          "name": "Does content marketing help with SEO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — closely. Search engines rank content that genuinely answers what people search for, so strategy-led content is one of the strongest foundations for organic visibility. We plan content and SEO together so they reinforce each other."
          }
        },
        {
          "@type": "Question",
          "name": "Do you write the content yourselves, or use AI?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our content is written and reviewed by a senior team grounded in real subject expertise. We use modern tools to work efficiently, but we fact-check everything and never publish generic, unchecked AI output as your brand's voice."
          }
        },
        {
          "@type": "Question",
          "name": "How long does content marketing take to show results?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Content marketing is a months-not-weeks discipline. Timelines depend on your starting point, your market's competitiveness, and how consistently you publish, so we set realistic expectations up front rather than promising a fixed date."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer content marketing for B2B companies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. As a B2B content marketing agency, we produce the in-depth, trust-building content that longer B2B sales cycles need, mapped to the questions buyers ask at each stage."
          }
        }
      ]
    },
