    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does social media marketing cost in Calgary?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on how many platforms, how much content, and whether you run paid ads — so we scope it after a free audit rather than quoting a one-size-fits-all price. Where you run paid social, that ad spend is separate from our management fee. Transparent pricing, no hidden fees, no long-term lock-in."
          }
        },
        {
          "@type": "Question",
          "name": "Which social media platforms should my Calgary business be on?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not all of them — only the ones your customers actually use. We recommend the right mix (often Instagram, Facebook, and LinkedIn, sometimes TikTok) based on your audience and goals, rather than spreading you thin."
          }
        },
        {
          "@type": "Question",
          "name": "How soon will I see results from social media management?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Social compounds: consistency builds audience and trust over months, while paid social can drive traffic and leads sooner. We focus on real business outcomes, not vanity metrics. These are general expectations, not guarantees."
          }
        },
        {
          "@type": "Question",
          "name": "Do you create all the content for my Calgary business?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — strategy, copy, and graphics are handled by our team, with your input and approval. You stay in control of the brand without doing the day-to-day work."
          }
        }
      ]
    },
