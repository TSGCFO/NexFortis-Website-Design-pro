    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is local SEO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Local SEO is the work that gets your business shown to people searching nearby — in the Google map pack, on 'near me' queries, and on Google Maps. It's driven mostly by your Google Business Profile, consistent business information across the web, reviews, and location-relevant content."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a storefront to do local SEO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Service-area businesses that travel to customers — IT support, trades, consultants, home services — can rank locally without a public address by setting a service area on the Google Business Profile. We configure it correctly so you appear for the areas you actually serve."
          }
        },
        {
          "@type": "Question",
          "name": "How important are Google reviews?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Very. Reviews influence both your map-pack ranking and whether a searcher chooses you over the business listed next to you. Steady, genuine reviews and prompt responses are one of the highest-return activities in local SEO, so we build a simple system to earn them."
          }
        },
        {
          "@type": "Question",
          "name": "How long does local SEO take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Google Business Profile improvements can move the map pack within weeks, faster than standard SEO. Citations, reviews, and location pages compound over two to four months. Competitive urban areas take longer than quieter suburbs, and we set expectations against your specific market up front."
          }
        },
        {
          "@type": "Question",
          "name": "Can you handle multiple locations?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. We manage separate profiles, citations, and location pages for each branch or service area, keeping the business information consistent across all of them while tailoring the local content to each place you operate."
          }
        }
      ]
    },
