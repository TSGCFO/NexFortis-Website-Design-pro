    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is local SEO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Local SEO is the work that puts your business in front of people searching nearby — the Google map pack, 'near me' searches, and Google Maps. Most of it comes down to four things: your Google Business Profile, business details that stay consistent everywhere online, your reviews, and content that actually speaks to the area you serve."
          }
        },
        {
          "@type": "Question",
          "name": "Do I need a storefront to do local SEO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not at all. Plenty of our clients go to the customer rather than the other way around — IT support, trades, consultants, home services. Google lets you set a service area instead of a public address, and as long as it is configured properly you show up for the places you actually cover. We set that up so you are not accidentally invisible or, worse, ranking for towns you don't serve."
          }
        },
        {
          "@type": "Question",
          "name": "How important are Google reviews?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hugely, and on two fronts. Reviews feed into where you land in the map pack, and they are usually the deciding factor when a searcher is choosing between you and the business listed right beside you. A slow, steady stream of genuine reviews — and a reply to every one — is one of the highest-return things a local business can do, so we put a simple system in place to keep them coming."
          }
        },
        {
          "@type": "Question",
          "name": "How long does local SEO take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Some of it moves quickly. Tidying up and optimising a Google Business Profile can shift the map pack within a few weeks. The slower-burning pieces — citations, reviews, location pages — tend to build over two to four months. A busy downtown market takes longer than a quieter suburb, and we will tell you honestly which one you are in before we start."
          }
        },
        {
          "@type": "Question",
          "name": "Can you handle multiple locations?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Each branch or service area gets its own profile, its own citations, and its own location page, all kept consistent with each other while the content stays specific to each place. We do this for businesses running anything from two locations to a dozen."
          }
        }
      ]
    },
