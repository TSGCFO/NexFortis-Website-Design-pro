    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does PPC management cost in Toronto?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "There are two parts: your ad spend (paid to Google) and our management fee — and we scope both after a free audit rather than quoting a one-size-fits-all price. Transparent pricing, no hidden fees, no long-term lock-in."
          }
        },
        {
          "@type": "Question",
          "name": "How soon will I see results from Google Ads in Toronto?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Paid ads can start driving traffic within days of launch — that is PPC's advantage over SEO. Turning that traffic into profitable, efficient conversions takes a few weeks of optimisation. These are general expectations, not guarantees."
          }
        },
        {
          "@type": "Question",
          "name": "Do I own my Google Ads account?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — always. We build campaigns in your own Google Ads account, so your data, history, and account stay with you if we ever part ways. No hostage-taking."
          }
        },
        {
          "@type": "Question",
          "name": "Google Ads or SEO — which should my Toronto business choose?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "They do different jobs: PPC buys you immediate visibility and fast testing, while SEO compounds into durable, lower-cost traffic over time. Most businesses are best served by both, and we can advise on the right mix."
          }
        }
      ]
    },
